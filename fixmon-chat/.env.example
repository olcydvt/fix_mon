# Copy to .env and fill in the one you actually use, or export it in the shell.
#
# Only the provider named in config.yaml has its key read, and startup fails if
# it is missing. That is deliberate: a key that is only discovered to be absent
# when someone asks the first question is discovered mid-incident.

# provider: deepseek
DEEPSEEK_API_KEY=

# provider: openai
OPENAI_API_KEY=

# provider: anthropic
ANTHROPIC_API_KEY=

# provider: gemini
GEMINI_API_KEY=

# provider: local (vLLM, Ollama, LM Studio). Usually unused by the server, but
# the loader requires a value so that a misconfigured provider fails loudly
# rather than sending an unauthenticated request somewhere unintended.
LOCAL_API_KEY=unused

